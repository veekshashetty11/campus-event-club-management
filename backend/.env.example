# ============================================================
# Campus Event & Club Management System - Environment Template
# Placeholders only. Copy to .env and configure local credentials.
# ============================================================

# Application Configuration
APP_NAME="Campus Event & Club Management API"
APP_ENV="development"
DEBUG=true

# Server Binding
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (comma-separated; never use '*' in production)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Database Connection URL (PostgreSQL with psycopg synchronous driver)
DATABASE_URL="postgresql+psycopg://<username>:<password>@localhost:5432/campus_events_dev"

# Authentication & JWT Configuration
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
